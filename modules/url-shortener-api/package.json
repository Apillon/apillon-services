{
  "name": "@apillon/url-shortener-api",
  "version": "2.2.0",
  "description": "Apillon url-shortener API",
  "author": "Apillon",
  "license": "GNU GPL V3",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "tsc && eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "cross-env APP_ENV=testing LOG_TARGET=none jest --detectOpenHandles --runInBand --forceExit --silent",
    "test:logging": "cross-env APP_ENV=test LOG_TARGET=console jest --detectOpenHandles --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand --forceExit",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "tsc": "tsc",
    "dev": "nodemon ./src/scripts/dev/run-server.ts",
    "deploy:prod": "node -r ts-node/register ../../scripts/lambda/deploy production",
    "deploy:staging": "node -r ts-node/register ../../scripts/lambda/deploy staging",
    "deploy:dev": "node -r ts-node/register ../../scripts/lambda/deploy dev",
    "deploy:test": "node -r ts-node/register ../../scripts/lambda/deploy test"
  },
  "dependencies": {
    "@apillon/lib": "*"
  },
  "devDependencies": {
    "@apillon/tests-lib": "*",
    "eslint-config-common": "*",
    "tsconfig": "*"
  },
  "jest": {
    "testTimeout": 1800000,
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json"
    ],
    "rootDir": "src",
    "testPathIgnorePatterns": [
      "dist/*"
    ],
    "testRegex": ".*\\.test\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverage": false,
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "preset": "ts-jest",
    "verbose": true
  }
}
